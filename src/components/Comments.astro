---
// Giscus comments backed by this repo's GitHub Discussions: https://giscus.app/
const GISCUS = {
  repo: "YamenSharaf/yamen.dev",
  repoId: "R_kgDOMyFPVw",
  category: "Comments",
  categoryId: "DIC_kwDOMyFPV84Cionj",
  mapping: "title",
  strict: "0",
  reactionsEnabled: "1",
  emitMetadata: "0",
  inputPosition: "top",
  lang: "en",
  loading: "lazy",
};
---

<section id="comments" class="mt-8" data-giscus={JSON.stringify(GISCUS)}>
</section>

<script>
  const LIGHT_THEME = "light";
  const DARK_THEME = "dark_dimmed";

  const currentTheme = () =>
    document.documentElement.dataset.theme === "dark"
      ? DARK_THEME
      : LIGHT_THEME;

  function mountGiscus() {
    const container = document.querySelector<HTMLElement>("#comments");
    if (!container?.dataset.giscus || container.childElementCount > 0) return;

    const config = JSON.parse(container.dataset.giscus) as Record<
      string,
      string
    >;
    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    for (const [key, value] of Object.entries(config)) {
      script.setAttribute(
        `data-${key.replace(/[A-Z]/g, c => `-${c.toLowerCase()}`)}`,
        value
      );
    }
    script.setAttribute("data-theme", currentTheme());
    container.appendChild(script);
  }

  // Keep the iframe in sync with the site's theme toggle and OS preference.
  new MutationObserver(() => {
    document
      .querySelector<HTMLIFrameElement>("iframe.giscus-frame")
      ?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: currentTheme() } } },
        "https://giscus.app"
      );
  }).observe(document.documentElement, { attributeFilter: ["data-theme"] });

  document.addEventListener("astro:page-load", mountGiscus);
</script>
